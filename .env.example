#   cp .env.example .env
#
# application.yml의 ${ENV_VAR}는 전부 여기에 대응하는 항목이 있어야 한다.
# 새 환경변수를 yml에 추가하면 이 파일도 같이 갱신한다.

# DB — 로컬은 docker/local/docker-compose.yml의 값과 맞춰져 있다.
DB_URL=jdbc:mysql://127.0.0.1:3306/toasty?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_USERNAME=toasty
DB_PASSWORD=toasty

# 컨테이너가 쓸 호스트 포트이며, 바꾸면 위 DB_URL의 포트도 같이 바꿔야 한다.
MYSQL_PORT=3306

# CORS — 프론트 개발 서버
CORS_ALLOWED_ORIGINS=http://localhost:3000
CORS_ALLOWED_METHODS=GET,POST,PATCH,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=*

# 카카오 로그인 앱 키
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# JWT — secret은 최소 32바이트 랜덤 문자열로 채운다 (예: openssl rand -base64 48)
JWT_SECRET=
# 30분 (30 * 60 * 1000)
JWT_ACCESS_TOKEN_EXPIRATION_MILLIS=1800000
# 14일 (14 * 24 * 60 * 60 * 1000)
JWT_REFRESH_TOKEN_EXPIRATION_MILLIS=1209600000

# Redis — 로컬은 docker/local/docker-compose.yml의 값과 맞춰져 있다.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
