# 카카오 로그인 앱 키
KAKAO_CLIENT_ID=

# 액세스 토큰 서명 키
JWT_SECRET=

# DB 접속 정보
#DB_URL=
#DB_USERNAME=
#DB_PASSWORD=

# Redis 접속 정보
#REDIS_HOST=
#REDIS_PORT=

# 프론트 도메인
#CORS_ALLOWED_ORIGINS=

# 프론트가 카카오 인가 요청에 사용한 redirect_uri
#KAKAO_REDIRECT_URI=

# 카카오 앱에서 client secret 사용을 켠 경우에만 필요
#KAKAO_CLIENT_SECRET=

# 상품 사진 버킷 — 개발·운영이 갈리므로 반드시 채운다
AWS_S3_BUCKET=

# 저장된 사진을 브라우저가 읽는 주소 — 반드시 채운다
AWS_S3_PUBLIC_BASE_URL=
