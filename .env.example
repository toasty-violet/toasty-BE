#   cp .env.example .env
#
# application.yml의 ${ENV_VAR}는 전부 여기에 대응하는 항목이 있어야 한다.
# 새 환경변수를 yml에 추가하면 이 파일도 같이 갱신한다.

# DB — 로컬은 docker/local/docker-compose.yml의 값과 맞춰져 있다.
DB_URL=jdbc:mysql://127.0.0.1:3306/toasty?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_USERNAME=toasty
DB_PASSWORD=toasty

# 컨테이너가 쓸 호스트 포트이며, 바꾸면 위 DB_URL의 포트도 같이 바꿔야 한다.
MYSQL_PORT=3306

# AWS — region은 IVS와 S3가 함께 쓴다. IVS 지원 리전만 가능
# (us-east-1, us-west-2, ap-northeast-1, ap-northeast-2, ap-south-1, eu-central-1, eu-west-1)
AWS_REGION=ap-northeast-2
# BASIC은 트랜스코딩이 없어 시청자 회선이 느리면 버퍼링이 걸린다. 필요해지면 STANDARD로 올린다.
IVS_CHANNEL_TYPE=BASIC
IVS_LATENCY_MODE=LOW

# S3 — 상품 사진. products/ 밑만 퍼블릭 읽기가 열려 있다.
AWS_S3_BUCKET=toasty-media
# 라이브 저장 전에 올라온 사진이 머무는 경로.
# 버킷 수명주기 규칙이 이 경로만 정리하므로 바꾸면 규칙도 함께 바꿔야 한다.
AWS_S3_PENDING_PREFIX=products/pending/
# presigned URL 유효 시간(초). 브라우저가 이 안에 업로드를 끝내야 한다.
AWS_S3_PRESIGNED_URL_EXPIRY_SECONDS=300
# 저장된 사진을 브라우저가 읽는 주소. 나중에 CDN을 붙이면 이 값만 바꾼다.
AWS_S3_PUBLIC_BASE_URL=https://toasty-media.s3.ap-northeast-2.amazonaws.com

# AWS 자격증명은 여기 두지 않는다. 이 파일은 Spring 프로퍼티로만 로드되어
# SDK가 읽는 OS 환경변수가 되지 않는다. 셸 환경변수나 `aws configure` profile을 쓴다.

# CORS — 프론트 개발 서버
CORS_ALLOWED_ORIGINS=http://localhost:3000
CORS_ALLOWED_METHODS=GET,POST,PATCH,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=*

# 카카오 로그인 앱 키
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
# 프론트가 카카오 인가 요청 시 사용한 redirect_uri
KAKAO_REDIRECT_URI=http://localhost:3000/auth/login/callback

# JWT 토큰 발급키
JWT_SECRET=

# 토큰 만료시간
ACCESS_TOKEN_EXPIRATION=30m
REFRESH_TOKEN_EXPIRATION=14d

# Redis — 로컬은 docker/local/docker-compose.yml의 값과 맞춰져 있다.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
