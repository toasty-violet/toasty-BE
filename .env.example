# 로컬 개발용 예시. 값을 채워 루트에 .env로 두면 애플리케이션이 읽는다.
# 배포 서버에서는 이 파일 대신 서버의 docker/prod/.env로 주입한다.

# 카카오 로그인 앱 키
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# 탈퇴할 때 카카오 연결을 끊는 데 쓴다. 앱 설정 > 앱 키의 Admin 키.
# 모든 회원에 대해 동작하는 키라 프론트로 내려보내면 안 된다.
KAKAO_ADMIN_KEY=

# 카카오 인가 요청에 사용한 redirect_uri
KAKAO_REDIRECT_URI=http://localhost:3000/auth/login/callback

# 액세스 토큰 서명 키
JWT_SECRET=

# DB 접속 정보
DB_URL=jdbc:mysql://127.0.0.1:3306/toasty?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_USERNAME=
DB_PASSWORD=

# Redis 접속 정보
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# 프론트 도메인. 여러 개면 쉼표로 잇는다
# 배포: https://toasty.kr,https://www.toasty.kr
CORS_ALLOWED_ORIGINS=http://localhost:3000

# 사진 버킷
AWS_S3_BUCKET=

# 저장된 사진을 브라우저가 읽는 주소
AWS_S3_PUBLIC_BASE_URL=

# point3 결제 API 인증 토큰
POINT3_API_TOKEN=

# --- 배포에서만 쓴다 ---

# 앞단 Caddy가 인증서를 받을 도메인. 이 이름의 A 레코드가 서버를 가리켜야 발급된다
#API_DOMAIN=api.toasty.kr

# 인증서 만료 알림을 받을 주소
#ACME_EMAIL=
