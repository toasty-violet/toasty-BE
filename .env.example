#   cp .env.example .env
# 카카오 로그인 앱 키
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# 카카오 인가 요청에 사용한 redirect_uri
KAKAO_REDIRECT_URI=http://localhost:3000/auth/login/callback

# 액세스 토큰 서명 키
JWT_SECRET=

# DB 접속 정보
# DB_URL=
# DB_USERNAME=
# DB_PASSWORD=

# Redis 접속 정보
# REDIS_HOST=
# REDIS_PORT=

# 프론트 도메인
# CORS_ALLOWED_ORIGINS=

# AWS 리전 — IVS와 S3가 함께 쓴다. IVS 지원 리전만 가능
# AWS_REGION= us-east-1 / us-west-2 / ap-northeast-1 / ap-northeast-2 / ap-south-1 / eu-central-1 / eu-west-1

# IVS 채널 타입
# IVS_CHANNEL_TYPE=

# 상품 사진 버킷
# AWS_S3_BUCKET=

# 라이브 저장 전 사진이 머무는 경로. 버킷 수명주기 규칙이 정리하는 경로와 같아야 한다
# AWS_S3_PENDING_PREFIX=

# 업로드 주소 유효 시간(초)
# AWS_S3_PRESIGNED_URL_EXPIRY_SECONDS=

# 저장된 사진을 브라우저가 읽는 주소. CDN을 붙이면 이 값만 바꾼다
# AWS_S3_PUBLIC_BASE_URL=
