
#   cp .env.example .env
#
# application.yml의 ${ENV_VAR}는 전부 여기에 대응하는 항목이 있어야 한다.
# 새 환경변수를 yml에 추가하면 이 파일도 같이 갱신한다.

# DB — 로컬은 docker/local/docker-compose.yml의 값과 맞춰져 있다.
DB_URL=jdbc:mysql://localhost:3306/toasty?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_USERNAME=toasty
DB_PASSWORD=toasty


# 컨테이너가 쓸 호스트 포트이며, 바꾸면 위 DB_URL의 포트도 같이 바꿔야 한다.
MYSQL_PORT=3306

# AWS IVS — region은 IVS 지원 리전만 가능
# (us-east-1, us-west-2, ap-northeast-1, ap-northeast-2, ap-south-1, eu-central-1, eu-west-1)
AWS_REGION=ap-northeast-2
# BASIC은 트랜스코딩이 없어 시청자 회선이 느리면 버퍼링이 걸린다. 필요해지면 STANDARD로 올린다.
IVS_CHANNEL_TYPE=BASIC
IVS_LATENCY_MODE=LOW

# AWS 자격증명은 여기 두지 않는다. 이 파일은 Spring 프로퍼티로만 로드되어
# SDK가 읽는 OS 환경변수가 되지 않는다. 셸 환경변수나 `aws configure` profile을 쓴다.

# CORS — 프론트 개발 서버
CORS_ALLOWED_ORIGINS=http://localhost:3000
CORS_ALLOWED_METHODS=GET,POST,PATCH,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=*
